---
import { NAV, SITE_TITLE } from '../consts';
const path = Astro.url.pathname;
const active = (href: string) => path === href || path.startsWith(href);
---
<header class="site-header">
	<div class="wrap">
		<a class="brand" href="/">Ramlakhan<span class="brand-rest"> Madheshiya</span></a>
		<nav aria-label="Main">
			{NAV.map((item) => (
				<a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>
			))}
			<form class="search" role="search" action="/" onsubmit="return false">
				<label for="site-search" class="visually-hidden">Search the site</label>
				<svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
				<input id="site-search" type="search" placeholder="Search projects, posts, CV" autocomplete="off" spellcheck="false" tabindex="-1" />
				<button class="theme-toggle search-btn" type="button" aria-label="Search (press /)" aria-expanded="false" aria-controls="site-search">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
				</button>
			</form>
			<button class="theme-toggle theme-btn" type="button" aria-label="Toggle colour theme">
				<svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
				<svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
			</button>
		</nav>
	</div>
</header>
<script>
	document.querySelector('.theme-btn')?.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		try { localStorage.setItem('theme', next); } catch {}
	});
</script>

<script>
	// Header search: the icon opens a field; typing swaps the page for live
	// Pagefind results, and closing it (or clearing it) brings the page back.
	type Sub = { title: string; url: string; excerpt: string };
	type Result = { url: string; excerpt: string; meta: { title?: string }; sub_results?: Sub[] };
	type Pagefind = { debouncedSearch: (q: string, o?: object, ms?: number) => Promise<{ results: { data: () => Promise<Result> }[] } | null> };

	const form = document.querySelector<HTMLFormElement>('.search')!;
	const input = document.getElementById('site-search') as HTMLInputElement;
	const btn = form.querySelector<HTMLButtonElement>('.search-btn')!;
	const results = document.getElementById('search-results')!;
	const page = document.getElementById('page')!;
	const list = document.getElementById('search-list')!;
	const status = document.getElementById('search-status')!;
	const PAGEFIND = ['', 'pagefind', 'pagefind.js'].join('/'); // built after Astro, so keep it out of the bundle
	let pagefind: Promise<Pagefind> | null = null;
	const load = () => (pagefind ??= import(/* @vite-ignore */ PAGEFIND) as Promise<Pagefind>);
	const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

	function open() {
		form.classList.add('is-open');
		btn.setAttribute('aria-expanded', 'true');
		input.tabIndex = 0;
		input.focus();
		load().catch(() => {});
	}
	function close() {
		form.classList.remove('is-open');
		btn.setAttribute('aria-expanded', 'false');
		input.tabIndex = -1;
		input.value = '';
		show('');
		input.blur();
	}

	async function show(q: string) {
		const query = q.trim();
		const url = new URL(location.href);
		if (query) url.searchParams.set('q', query); else url.searchParams.delete('q');
		history.replaceState(history.state, '', url);
		if (!query) { results.hidden = true; page.hidden = false; return; }
		results.hidden = false;
		page.hidden = true;
		scrollTo({ top: 0 });
		status.textContent = 'Searching…';

		let pf: Pagefind;
		try { pf = await load(); } catch { status.textContent = 'Search works on the published site.'; list.innerHTML = ''; return; }
		const search = await pf.debouncedSearch(query, {}, 150);
		if (search === null || input.value.trim() !== query) return; // a newer query is running

		const data = await Promise.all(search.results.slice(0, 10).map((r) => r.data()));
		status.textContent = data.length ? `${data.length} result${data.length > 1 ? 's' : ''} for “${query}”` : `No results for “${query}”`;
		list.innerHTML = data.map((d) => {
			const subs = (d.sub_results ?? []).filter((s) => s.url !== d.url).slice(0, 3);
			return `<li>
				<h3><a href="${esc(d.url)}">${esc(d.meta.title ?? d.url)}</a></h3>
				<p>${d.excerpt}</p>
				${subs.length ? `<ul class="sub-results">${subs.map((s) => `<li><a href="${esc(s.url)}">${esc(s.title)}</a><p>${s.excerpt}</p></li>`).join('')}</ul>` : ''}
			</li>`;
		}).join('');
	}

	btn.addEventListener('click', open);
	// An empty field closes itself when focus or a click goes elsewhere.
	input.addEventListener('blur', () => setTimeout(() => { if (!input.value.trim() && !form.contains(document.activeElement)) close(); }, 120));
	document.addEventListener('pointerdown', (e) => {
		if (form.classList.contains('is-open') && !input.value.trim() && !form.contains(e.target as Node)) close();
	});
	input.addEventListener('input', () => show(input.value));
	input.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.preventDefault(); close(); } });
	window.addEventListener('keydown', (e) => {
		const t = document.activeElement;
		if (e.key !== '/' || t instanceof HTMLInputElement || t instanceof HTMLTextAreaElement) return;
		e.preventDefault();
		open();
	});

	const initial = new URLSearchParams(location.search).get('q');
	if (initial) { open(); input.value = initial; show(initial); }
</script>

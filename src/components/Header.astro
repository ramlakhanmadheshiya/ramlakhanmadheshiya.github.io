---
import { NAV, CV_PDF } from '../consts';
const path = Astro.url.pathname;
const active = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="site-header">
	<div class="wrap">
		<a class="brand" href="/" aria-label="Ramlakhan Madheshiya">Ramlakhan Madheshiya</a>

		<div class="nav-right">
			<nav class="nav-links" aria-label="Main Navigation">
				{NAV.map((item) => (
					<a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>
						{item.label}
					</a>
				))}
			</nav>

			<!-- Expanding Search with Floating Live Results -->
			<div class="nav-search" data-search-root>
				<label class="nav-search-field" for="nav-search-input">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="11" cy="11" r="7"></circle>
						<path d="m20 20-4.2-4.2"></path>
					</svg>
					<input id="nav-search-input" class="nav-search-input" type="search" placeholder="Search..." autocomplete="off" spellcheck="false" aria-label="Search" />
				</label>
				<div class="nav-search-results" hidden></div>
			</div>

			<!-- Theme Toggle Button -->
			<button class="theme-toggle" id="theme-toggle-btn" type="button" aria-label="Toggle theme" title="Toggle theme">
				<svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
				</svg>
				<svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
				</svg>
			</button>
		</div>
	</div>
</header>

<script>
	// Theme toggle script
	const themeBtn = document.getElementById('theme-toggle-btn');
	themeBtn?.addEventListener('click', () => {
		const currentTheme = document.documentElement.dataset.theme;
		const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = nextTheme;
		try {
			localStorage.setItem('theme', nextTheme);
		} catch {}
	});

	// In-navbar expanding search with live Pagefind dropdown
	type Result = { url: string; excerpt: string; meta: { title?: string } };
	type Pagefind = { debouncedSearch: (q: string, o?: object, ms?: number) => Promise<{ results: { data: () => Promise<Result> }[] } | null> };

	const searchRoot = document.querySelector<HTMLElement>('[data-search-root]');
	const input = document.getElementById('nav-search-input') as HTMLInputElement | null;
	const resultsContainer = searchRoot?.querySelector<HTMLElement>('.nav-search-results');

	const PAGEFIND_PATH = ['', 'pagefind', 'pagefind.js'].join('/');
	let pagefindInstance: Promise<Pagefind> | null = null;
	const loadPagefind = () => (pagefindInstance ??= import(/* @vite-ignore */ PAGEFIND_PATH) as Promise<Pagefind>);

	const escapeHtml = (s: string) => s.replace(/[&<>"']/g, (c) => ({
		'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
	}[c]!));

	const closeSearch = () => {
		if (!searchRoot || !resultsContainer || !input) return;
		searchRoot.removeAttribute('data-open');
		resultsContainer.hidden = true;
		resultsContainer.innerHTML = '';
		input.value = '';
	};

	input?.addEventListener('focus', () => {
		searchRoot?.setAttribute('data-open', '');
		loadPagefind().catch(() => {});
	});

	input?.addEventListener('input', async () => {
		if (!resultsContainer || !input) return;
		const query = input.value.trim();

		if (!query) {
			resultsContainer.hidden = true;
			resultsContainer.innerHTML = '';
			return;
		}

		let pf: Pagefind;
		try {
			pf = await loadPagefind();
		} catch {
			resultsContainer.hidden = false;
			resultsContainer.innerHTML = '<p class="nav-search-empty">Search index available on published site.</p>';
			return;
		}

		const search = await pf.debouncedSearch(query, {}, 120);
		if (search === null || input.value.trim() !== query) return;

		const data = await Promise.all(search.results.slice(0, 6).map((r) => r.data()));

		resultsContainer.hidden = false;
		if (data.length === 0) {
			resultsContainer.innerHTML = '<p class="nav-search-empty">Nothing found.</p>';
		} else {
			resultsContainer.innerHTML = data.map((d) => `
				<a href="${escapeHtml(d.url)}">
					<span class="r-title">${escapeHtml(d.meta.title ?? d.url)}</span>
					<span class="r-excerpt">${d.excerpt}</span>
				</a>
			`).join('');
		}
	});

	// Keyboard handling: '/' focuses search, Escape closes
	window.addEventListener('keydown', (e) => {
		if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
			e.preventDefault();
			input?.focus();
		} else if (e.key === 'Escape' && searchRoot?.hasAttribute('data-open')) {
			closeSearch();
			input?.blur();
		}
	});

	// Click outside closes
	document.addEventListener('click', (e) => {
		if (searchRoot && !searchRoot.contains(e.target as Node) && !input?.value.trim()) {
			closeSearch();
		}
	});
</script>

---
import Base from '../layouts/Base.astro';
import { CV_PDF, EMAIL } from '../consts';

const experience = [
	{
		when: 'Apr – Nov 2025',
		title: 'SDE Intern',
		org: 'National Technical Research Organisation (NTRO)',
		note: 'Onsite · 3 months, in phases',
		points: [
			'Designed and built a security compliance tool, onsite, that supports internal verification and audit operations.',
			'Automated validation checks against system security configurations, reducing manual verification overhead (details confidential under NDA).'
		],
	},
	{
		when: 'Jul – Dec 2024',
		title: 'Web Developer Intern',
		org: 'Krtya Technologies Pvt. Ltd',
		note: 'React, Node.js, Express, PostgreSQL',
		points: [
			'Built a full-stack checkout portal with secure payment handling and order reconciliation.',
			'Optimized database queries and connection pooling in PostgreSQL to reduce checkout response times.'
		],
	},
	{
		when: 'Jan 2024 – Jan 2025',
		title: 'Technical Content Writer',
		org: 'GeeksforGeeks',
		note: 'Remote',
		points: [
			'Wrote more than 12 technical articles on Python internals, software testing, and deep learning with PyTorch.'
		],
	},
];
---
<Base title="CV" description="Curriculum vitae of Ramlakhan Madheshiya: open-source contributions, experience, education, and skills.">
	<header style="margin-bottom:3rem;">
		<span class="eyebrow">Curriculum vitae</span>
		<h1>Ramlakhan Madheshiya</h1>
		<p class="lede">
			Software engineer with a B.Tech in Computer Science and Engineering (2026). Upstream contributor to Julia's SciML differential equation solvers and builder of offline-first tools and games.
		</p>
		<div class="actions">
			<a class="btn primary" href={CV_PDF} download>Download PDF</a>
			<a class="btn" href={`mailto:${EMAIL}`}>Email me</a>
		</div>
	</header>

	<!-- Open Source Section (Merged Only) -->
	<section class="section" style="margin-top:0;">
		<h2>Open source</h2>
		<div class="cv-item">
			<span class="when">Oct 2026 – now</span>
			<div>
				<h3>SciML / OrdinaryDiffEq.jl <span class="badge-merged">merged</span></h3>
				<p>
					Merged pull requests to the delay differential equation solvers (DelayDiffEq's MethodOfSteps): lag handling, zero constant lag validation, and interpolation method dispatch. Reported and diagnosed 5 upstream issues.
				</p>
			</div>
		</div>

		<div class="cv-item">
			<span class="when">Sep 2024</span>
			<div>
				<h3>ibis-project / ibis <span class="badge-merged">merged</span></h3>
				<p>
					Improved the documentation site's accessibility and navigation by making nested dropdown menus scrollable.
				</p>
			</div>
		</div>

		<p style="margin-top:1rem;font-size:0.92rem;">
			<a href="/projects/#open-source">Full list of pull requests &rarr;</a>
		</p>
	</section>

	<!-- Professional Experience -->
	<section class="section">
		<h2>Experience</h2>
		{experience.map((e) => (
			<div class="cv-item">
				<span class="when">{e.when}</span>
				<div>
					<h3>{e.title} · {e.org}</h3>
					<p style="font-size:0.88rem;color:var(--muted);">{e.note}</p>
					<ul>
						{e.points.map((p) => <li>{p}</li>)}
					</ul>
				</div>
			</div>
		))}
	</section>

	<!-- Education -->
	<section class="section">
		<h2>Education</h2>
		<div class="cv-item">
			<span class="when">2022 – 2026</span>
			<div>
				<h3>B.Tech, Computer Science and Engineering</h3>
				<p>Uka Tarsadia University (UTU), Bardoli, Gujarat, India · CGPA: 8.97 / 10</p>
			</div>
		</div>

		<div class="cv-item">
			<span class="when">2022</span>
			<div>
				<h3>Higher Secondary Certificate (Class 12), Mathematics</h3>
				<p>Shree Vasishtha Vidhyalaya · 91.2% · JEE Main percentile: 96.0359656</p>
			</div>
		</div>

		<div class="cv-item">
			<span class="when">2020</span>
			<div>
				<h3>Secondary School Certificate (Class 10)</h3>
				<p>Shree Vasishtha Vidhyalaya · 86.4%</p>
			</div>
		</div>
	</section>

	<!-- Honors & Highlights -->
	<section class="section">
		<h2>Highlights</h2>
		<div class="cv-item">
			<span class="when">2024</span>
			<div>
				<h3>Smart India Hackathon finalist</h3>
				<p>Reached the final round of India's national hackathon with a CIS benchmark security policy tool built for NTRO.</p>
			</div>
		</div>

		<div class="cv-item">
			<span class="when">2025</span>
			<div>
				<h3>First-author manuscript</h3>
				<p>
					Windows CVE Analysis: Vulnerabilities, Exploits, and Defenses.
					<a href="https://github.com/ramlakhanmadheshiya/Research-Papers/tree/main/2025-Windows_CVE_Analysis" target="_blank" rel="noopener noreferrer">Read the paper ↗</a>.
				</p>
			</div>
		</div>

		<div class="cv-item">
			<span class="when">Class 9</span>
			<div>
				<h3>First prize, International Mathematics Olympiad</h3>
			</div>
		</div>
	</section>

	<!-- Skills Matrix -->
	<section class="section">
		<h2>Skills</h2>
		<dl class="skills-list">
			<dt>Languages</dt>
			<dd>Julia, Python, C, C++, C#, JavaScript, TypeScript, GDScript, HTML/CSS, Shell, SQL</dd>
			<dt>Frameworks & tools</dt>
			<dd>Godot 4, Astro, .NET/WPF, React, Node.js, Express, IndexedDB, Docker, Git, GitHub Actions</dd>
		</dl>
	</section>
</Base>

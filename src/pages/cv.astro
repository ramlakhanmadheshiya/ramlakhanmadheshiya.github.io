---
import Base from '../layouts/Base.astro';
import { CV_PDF, EMAIL } from '../consts';

const experience = [
	{
		when: 'Apr – Nov 2025',
		title: 'SDE Intern',
		org: 'National Technical Research Organisation (NTRO)',
		note: 'Onsite · 3 months, in phases',
		points: [
			'Designed and built a security compliance tool, onsite, that supports internal verification and audit operations.',
			'Automated validation checks against system security configurations, reducing manual verification overhead (details confidential under NDA).'
		],
	},
	{
		when: 'Jul – Dec 2024',
		title: 'Web Developer Intern',
		org: 'Krtya Technologies Pvt. Ltd',
		note: 'React, Node.js, Express, PostgreSQL',
		points: [
			'Built a full-stack checkout portal with secure payment handling and order reconciliation.',
			'Optimized database queries and connection pooling in PostgreSQL to reduce checkout response times.'
		],
	},
	{
		when: 'Jan 2024 – Jan 2025',
		title: 'Technical Content Writer',
		org: 'GeeksforGeeks',
		note: 'Remote',
		points: [
			'Wrote more than 12 technical articles on Python internals, software testing, and deep learning with PyTorch.'
		],
	},
];
---
<Base title="CV" description="Curriculum vitae of Ramlakhan Madheshiya: open-source contributions, experience, education, and skills.">
	<header style="margin-bottom:3rem;">
		<span class="eyebrow">Curriculum vitae</span>
		<h1>Ramlakhan Madheshiya</h1>
		<p class="lede">
			Software engineer with a B.Tech in Computer Science and Engineering (2026). Upstream contributor to Julia's SciML differential equation solvers and builder of offline-first tools and games.
		</p>
		<div class="actions">
			<a class="btn primary" href={CV_PDF} target="_blank" rel="noopener noreferrer">View in Browser ↗</a>
			<a class="btn" href={CV_PDF} download="ramlakhan-madheshiya-cv.pdf">Download PDF ↓</a>
			<a class="btn" href="#pdf-preview">Preview Document ↓</a>
			<a class="btn" href={`mailto:${EMAIL}`}>Email me</a>
		</div>
	</header>

	<!-- Open Source Section (Merged badge in front of PRs only) -->
	<section class="section" style="margin-top:0;">
		<h2>Open source</h2>
		<div class="cv-item">
			<span class="when">Oct 2026 – now</span>
			<div>
				<h3>SciML / OrdinaryDiffEq.jl</h3>
				<p>
					Contributions to delay differential equation solvers (DelayDiffEq's MethodOfSteps):
				</p>
				<ul>
					<li><span class="badge-merged">merged</span> PR #4874: Build the fixed-point solver for constrained MethodOfSteps with dependent lags.</li>
					<li><span class="badge-merged">merged</span> PR #4849: Allow zero constant lags and reject wrong-sign ones in DDE initialization.</li>
					<li><span class="badge-merged">merged</span> PR #4834: Define default_linear_interpolation with the problem first to preserve solver dispatch.</li>
					<li><span class="badge-merged">merged</span> PR #4950: Drop the TruncatedStacktraces hint from derivative order error.</li>
				</ul>
			</div>
		</div>

		<div class="cv-item">
			<span class="when">Nov 2026 – now</span>
			<div>
				<h3>SciML / ModelingToolkit.jl</h3>
				<p>
					Contributions to symbolic modeling, code generation, and compiler optimizations:
				</p>
				<ul>
					<li><span class="badge-merged">merged</span> PR #5375: Keep @nospecialize on constructor and op in process_SciMLProblem to prevent compiler specialization bloat.</li>
					<li><span class="badge-merged">merged</span> PR #5376: Pass code-generation options of a problem down to its event code handlers.</li>
					<li><span class="badge-merged">merged</span> PR #5345: Bind arrays indexed by a symbolic index in generated function wrappers.</li>
				</ul>
			</div>
		</div>

		<div class="cv-item">
			<span class="when">Sep 2024</span>
			<div>
				<h3>ibis-project / ibis</h3>
				<p>
					Improved the documentation site's accessibility:
				</p>
				<ul>
					<li><span class="badge-merged">merged</span> PR #10090: Make deep documentation navigation dropdowns scrollable and easier to view.</li>
				</ul>
			</div>
		</div>

		<p style="margin-top:1rem;font-size:0.92rem;">
			<a href="/projects/#open-source">Full list of pull requests &rarr;</a>
		</p>
	</section>

	<!-- Professional Experience -->
	<section class="section">
		<h2>Experience</h2>
		{experience.map((e) => (
			<div class="cv-item">
				<span class="when">{e.when}</span>
				<div>
					<h3>{e.title} · {e.org}</h3>
					<p style="font-size:0.88rem;color:var(--muted);">{e.note}</p>
					<ul>
						{e.points.map((p) => <li>{p}</li>)}
					</ul>
				</div>
			</div>
		))}
	</section>

	<!-- Projects -->
	<section class="section">
		<h2>Projects</h2>
		<div class="cv-item">
			<span class="when">2024</span>
			<div>
				<h3>PayTrack</h3>
				<p style="font-size:0.88rem;color:var(--muted);margin-bottom:0.35rem;">Godot, WebAssembly, Offline-First PWA</p>
				<p>Offline-first expense tracking and personal finance application engineered with Godot and WebAssembly to run entirely in the browser without server dependencies or cloud data sync.</p>
				<div class="cv-project-links">
					<a class="cv-link-pill" href="/paytrack/" target="_blank" rel="noopener noreferrer">
						<span>Launch Live App</span>
						<span class="pill-arrow">&rarr;</span>
					</a>
				</div>
			</div>
		</div>

		<div class="cv-item">
			<span class="when">2023</span>
			<div>
				<h3>Wildlife Acts</h3>
				<p style="font-size:0.88rem;color:var(--muted);margin-bottom:0.35rem;">HTML, CSS, JavaScript</p>
				<p>Interactive educational platform presenting national and international wildlife protection acts, biodiversity awareness, and species conservation policies.</p>
				<div class="cv-project-links">
					<a class="cv-link-pill" href="/wildlife/" target="_blank" rel="noopener noreferrer">
						<span>Explore Platform</span>
						<span class="pill-arrow">&rarr;</span>
					</a>
					<a class="cv-link-pill secondary" href="https://github.com/ramlakhanmadheshiya/Wildlife-Project" target="_blank" rel="noopener noreferrer">
						<span>GitHub Repository</span>
						<span class="pill-arrow">&rarr;</span>
					</a>
				</div>
			</div>
		</div>

		<div class="cv-item">
			<span class="when">2026</span>
			<div>
				<h3>Bill Studio</h3>
				<p style="font-size:0.88rem;color:var(--muted);margin-bottom:0.35rem;">JavaScript, PWA, IndexedDB, Web Crypto</p>
				<p>Free, offline-first billing web application with tax rules for 50+ countries, drag-and-drop bill designer, customer ledgers, payment QR codes, and client-side encrypted backups.</p>
				<div class="cv-project-links">
					<a class="cv-link-pill" href="/projects/bill-studio/" target="_blank" rel="noopener noreferrer">
						<span>Launch Live App</span>
						<span class="pill-arrow">&rarr;</span>
					</a>
					<a class="cv-link-pill secondary" href="https://github.com/ramlakhanmadheshiya/bill-studio" target="_blank" rel="noopener noreferrer">
						<span>GitHub Repository</span>
						<span class="pill-arrow">&rarr;</span>
					</a>
				</div>
			</div>
		</div>

		<div class="cv-item">
			<span class="when">2026</span>
			<div>
				<h3>Brainnova Studio: Single Shot & Puzzle Games</h3>
				<p style="font-size:0.88rem;color:var(--muted);margin-bottom:0.35rem;">GDScript, Godot 4, Android, Web</p>
				<p>Designed and developed algorithmic puzzle games. Single Shot (360 rooms) in closed testing on Google Play; all levels generated and verified by automated solvers.</p>
				<div class="cv-project-links">
					<a class="cv-link-pill" href="/BrainnovaStudio/games/" target="_blank" rel="noopener noreferrer">
						<span>Games Hub</span>
						<span class="pill-arrow">&rarr;</span>
					</a>
					<a class="cv-link-pill secondary" href="https://github.com/ramlakhanmadheshiya/single-shot" target="_blank" rel="noopener noreferrer">
						<span>GitHub Repository</span>
						<span class="pill-arrow">&rarr;</span>
					</a>
				</div>
			</div>
		</div>

		<div class="cv-item">
			<span class="when">2024</span>
			<div>
				<h3>GPO Compliance Manager</h3>
				<p style="font-size:0.88rem;color:var(--muted);margin-bottom:0.35rem;">C#, .NET, WPF · Smart India Hackathon Finalist</p>
				<p>Windows security tool generating and enforcing Group Policy Objects aligned with CIS benchmarks for the NTRO challenge.</p>
				<div class="cv-project-links">
					<a class="cv-link-pill secondary" href="https://github.com/ramlakhanmadheshiya/Project-Techolics_" target="_blank" rel="noopener noreferrer">
						<span>GitHub Repository</span>
						<span class="pill-arrow">&rarr;</span>
					</a>
				</div>
			</div>
		</div>

		<p style="margin-top:1rem;font-size:0.92rem;">
			<a href="/projects/">View all projects &rarr;</a>
		</p>
	</section>

	<!-- Education -->
	<section class="section">
		<h2>Education</h2>
		<div class="cv-item">
			<span class="when">2022 – 2026</span>
			<div>
				<h3>B.Tech, Computer Science and Engineering</h3>
				<p>Uka Tarsadia University (UTU), Bardoli, Gujarat, India · CGPA: 8.97 / 10</p>
			</div>
		</div>

		<div class="cv-item">
			<span class="when">2022</span>
			<div>
				<h3>Higher Secondary Certificate (Class 12), Mathematics</h3>
				<p>Shree Vasishtha Vidhyalaya · 91.2% · JEE Main percentile: 96.0359656</p>
			</div>
		</div>

		<div class="cv-item">
			<span class="when">2020</span>
			<div>
				<h3>Secondary School Certificate (Class 10)</h3>
				<p>Shree Vasishtha Vidhyalaya · 86.4%</p>
			</div>
		</div>
	</section>

	<!-- Honors & Highlights -->
	<section class="section">
		<h2>Highlights</h2>
		<div class="cv-item">
			<span class="when">2024</span>
			<div>
				<h3>Smart India Hackathon finalist</h3>
				<p>Reached the final round of India's national hackathon with a CIS benchmark security policy tool built for NTRO.</p>
			</div>
		</div>

		<div class="cv-item">
			<span class="when">2025</span>
			<div>
				<h3>First-author manuscript</h3>
				<p>
					Windows CVE Analysis: Vulnerabilities, Exploits, and Defenses.
					<a href="https://github.com/ramlakhanmadheshiya/Research-Papers/tree/main/2025-Windows_CVE_Analysis" target="_blank" rel="noopener noreferrer">Read the paper ↗</a>.
				</p>
			</div>
		</div>

		<div class="cv-item">
			<span class="when">Class 9</span>
			<div>
				<h3>First prize, International Mathematics Olympiad</h3>
			</div>
		</div>
	</section>

	<!-- Skills Matrix -->
	<section class="section">
		<h2>Skills</h2>
		<dl class="skills-list">
			<dt>Languages</dt>
			<dd>Julia, Python, C, C++, C#, JavaScript, TypeScript, GDScript, HTML/CSS, Shell, SQL</dd>
			<dt>Frameworks & tools</dt>
			<dd>Godot 4, Astro, .NET/WPF, React, Node.js, Express, IndexedDB, Docker, Git, GitHub Actions</dd>
		</dl>
	</section>

	<!-- In-Browser PDF Document Preview -->
	<section class="section cv-pdf-section" id="pdf-preview">
		<div class="cv-pdf-header">
			<div>
				<h2>CV Document Preview</h2>
				<p style="color:var(--muted);font-size:0.9rem;margin:0.25rem 0 0;">
					Compiled 2-page document layout. You can also view it in a separate browser tab or download it.
				</p>
			</div>
			<div class="cv-project-links" style="margin:0;">
				<a class="cv-link-pill" href={CV_PDF} target="_blank" rel="noopener noreferrer">
					<span>Open Fullscreen in Browser</span>
					<span class="pill-arrow">&rarr;</span>
				</a>
				<a class="cv-link-pill secondary" href={CV_PDF} download="ramlakhan-madheshiya-cv.pdf">
					<span>Download PDF</span>
					<span class="pill-arrow">&darr;</span>
				</a>
			</div>
		</div>
		<div class="cv-pdf-container">
			<iframe
				src={`${CV_PDF}#toolbar=1&navpanes=0`}
				title="Ramlakhan Madheshiya CV PDF"
				loading="lazy"
			>
				<p style="padding:1.5rem;text-align:center;">
					Your browser does not support inline PDFs. <a href={CV_PDF} target="_blank" rel="noopener noreferrer">Click here to view the CV in your browser</a>.
				</p>
			</iframe>
		</div>
	</section>
</Base>

---
import Base from '../layouts/Base.astro';
import { getPosts, fmtDate } from '../utils';
import { SOCIAL, EMAIL } from '../consts';
import { pullRequests } from '../data/projects';

const posts = (await getPosts()).slice(0, 3);
const mergedPRs = pullRequests.filter((pr) => pr.state === 'merged');

const featuredProjects = [
	{
		name: 'Bill Studio',
		domain: 'Offline-First Web App',
		year: '2026',
		blurb: 'Free, offline-first billing for 50+ countries: tax rules (GST, VAT, sales tax), drag-and-drop bill designer, customer ledgers, payment QR codes and client-side encrypted backups. Zero server required.',
		tags: ['JavaScript', 'PWA', 'IndexedDB', 'Web Crypto'],
		links: [
			{ label: 'Launch App', href: '/projects/bill-studio/' },
			{ label: 'Source', href: 'https://github.com/ramlakhanmadheshiya/bill-studio' }
		]
	},
	{
		name: 'ghtrack',
		domain: 'Developer Tooling',
		year: '2026',
		blurb: 'Client-side GitHub lifetime activity analyzer: exact counts of pull requests, issues, reviews, and comments in ~2 seconds for accounts with 48,000+ items without authentication, tokens, or servers.',
		tags: ['JavaScript', 'GitHub REST API', 'IndexedDB'],
		links: [
			{ label: 'Launch App', href: '/ghtrack/' },
			{ label: 'Source', href: 'https://github.com/ramlakhanmadheshiya/ghtrack' }
		]
	},
	{
		name: 'GPO Compliance Manager',
		domain: 'Security & Compliance',
		year: '2024',
		blurb: 'Windows system security application that generates and enforces customized Group Policy Objects aligned with CIS benchmarks. National finalist in Smart India Hackathon 2024 (NTRO challenge).',
		tags: ['C#', '.NET', 'WPF', 'CIS Benchmarks'],
		links: [
			{ label: 'Source', href: 'https://github.com/ramlakhanmadheshiya/Project-Techolics_' }
		]
	},
	{
		name: 'NTRO Security Compliance Suite',
		domain: 'System Hardening',
		year: '2025',
		blurb: 'Engineered onsite during a software engineering internship at the National Technical Research Organisation to automate security compliance verification and internal audit workflows.',
		tags: ['Security', 'System Hardening', 'Audit Tooling'],
		links: [
			{ label: 'CV Details', href: '/cv/' }
		]
	}
];

const ext = (href: string) => /^https?:/.test(href);
---
<Base index={false}>
	<!-- Fresh Minimal Hero -->
	<section class="hero">
		<span class="eyebrow">Software Engineer · India</span>
		<h1>Ramlakhan Madheshiya</h1>
		<p class="lede">
			Software engineer building dependable tools and systems. Upstream contributor to Julia's SciML scientific computing libraries, developer of offline-first client-side web applications, and security tooling researcher.
		</p>
		<div class="actions">
			<a class="btn primary" href="/projects/">See projects &rarr;</a>
			<a class="btn" href="/cv/">Read my CV &rarr;</a>
			<button class="btn" id="copy-email-btn" data-email={EMAIL} type="button" title="Copy email address">
				<span id="copy-text">Copy Email</span>
			</button>
		</div>
		<div class="social-links">
			{SOCIAL.map((s) => (
				<a href={s.href} target={ext(s.href) ? '_blank' : undefined} rel={ext(s.href) ? 'noopener noreferrer' : undefined}>
					{s.label}{s.label !== 'Email' && ' ↗'}
				</a>
			))}
		</div>
	</section>

	<!-- Selected Systems & Featured Work (Modern Minimal Showcase) -->
	<section class="section">
		<div class="section-head">
			<h2>Featured Work</h2>
			<a href="/projects/">All projects &rarr;</a>
		</div>
		<div class="showcase-grid">
			{featuredProjects.map((project) => (
				<article class="showcase-card">
					<div class="showcase-top">
						<span class="showcase-domain">{project.domain}</span>
						<span class="showcase-year">{project.year}</span>
					</div>
					<h3>{project.name}</h3>
					<p class="showcase-desc">{project.blurb}</p>
					<div class="tag-list">
						{project.tags.map((t) => <span class="tag">{t}</span>)}
					</div>
					<div class="showcase-links">
						{project.links.map((l) => (
							<a href={l.href} target={ext(l.href) ? '_blank' : undefined} rel={ext(l.href) ? 'noopener noreferrer' : undefined}>
								{l.label} {ext(l.href) ? '↗' : '→'}
							</a>
						))}
					</div>
				</article>
			))}
		</div>
	</section>

	<!-- Merged Open Source Contributions (Badge only in front of PR, not repo) -->
	<section class="section">
		<div class="section-head">
			<h2>Open Source</h2>
			<a href="/projects/#open-source">All contributions &rarr;</a>
		</div>
		<div class="oss-container">
			<div class="oss-block">
				<h3>
					<a href="https://github.com/SciML/OrdinaryDiffEq.jl" target="_blank" rel="noopener noreferrer">SciML / OrdinaryDiffEq.jl</a>
				</h3>
				<p>Production differential equation solvers in Julia (MethodOfSteps): lag handling, zero-lag step bound preservation, fixed-point solver construction, and interpolation dispatch.</p>
				<div class="pr-list">
					{mergedPRs.filter((p) => p.repo.includes('OrdinaryDiffEq')).map((pr) => (
						<div class="pr-item">
							<span class="badge-merged">merged</span>
							<a href={pr.url} target="_blank" rel="noopener noreferrer">#{pr.number}: {pr.title}</a>
						</div>
					))}
				</div>
			</div>

			<div class="oss-block">
				<h3>
					<a href="https://github.com/SciML/ModelingToolkit.jl" target="_blank" rel="noopener noreferrer">SciML / ModelingToolkit.jl</a>
				</h3>
				<p>Equation-oriented symbolic modeling framework in Julia: compiler specialization preservation, event codegen options propagation, and symbolic array indexing.</p>
				<div class="pr-list">
					{mergedPRs.filter((p) => p.repo.includes('ModelingToolkit')).map((pr) => (
						<div class="pr-item">
							<span class="badge-merged">merged</span>
							<a href={pr.url} target="_blank" rel="noopener noreferrer">#{pr.number}: {pr.title}</a>
						</div>
					))}
				</div>
			</div>

			<div class="oss-block">
				<h3>
					<a href="https://github.com/ibis-project/ibis" target="_blank" rel="noopener noreferrer">ibis-project / ibis</a>
				</h3>
				<p>Portable Python dataframe engine: resolved documentation accessibility with scrollable navigation menus.</p>
				<div class="pr-list">
					{mergedPRs.filter((p) => p.repo.includes('ibis')).map((pr) => (
						<div class="pr-item">
							<span class="badge-merged">merged</span>
							<a href={pr.url} target="_blank" rel="noopener noreferrer">#{pr.number}: {pr.title}</a>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- Technical Writing -->
	{posts.length > 0 && (
		<section class="section">
			<div class="section-head">
				<h2>Writing</h2>
				<a href="/blog/">All posts &rarr;</a>
			</div>
			<ul class="post-rows">
				{posts.map((post) => (
					<li class="post-row">
						<span class="post-date">{fmtDate(post.data.pubDate)}</span>
						<div class="post-content">
							<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
							<p>{post.data.description}</p>
						</div>
					</li>
				))}
			</ul>
		</section>
	)}

	<!-- Outside Work -->
	<section class="section" style="margin-top:4.5rem;">
		<h2>Outside work</h2>
		<p style="margin-top:0.5rem;max-width:var(--measure);color:var(--muted);">
			In my spare time I make small puzzle games with Godot 4, exploring procedural mechanics and level validation algorithms.
			They live at <a href="/BrainnovaStudio/games/">Brainnova Studio</a>.
		</p>
	</section>
</Base>

<script>
	const copyBtn = document.getElementById('copy-email-btn');
	const copyText = document.getElementById('copy-text');
	copyBtn?.addEventListener('click', async () => {
		const email = copyBtn.getAttribute('data-email');
		if (!email) return;
		try {
			await navigator.clipboard.writeText(email);
			if (copyText) copyText.textContent = 'Copied!';
			setTimeout(() => {
				if (copyText) copyText.textContent = 'Copy Email';
			}, 2000);
		} catch {
			window.location.href = `mailto:${email}`;
		}
	});
</script>

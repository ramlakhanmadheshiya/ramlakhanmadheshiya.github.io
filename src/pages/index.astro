---
import Base from '../layouts/Base.astro';
import { getPosts, fmtDate } from '../utils';
import { SOCIAL } from '../consts';

const posts = (await getPosts()).slice(0, 3);

const highlights = [
	{
		title: 'Security tool for NTRO',
		meta: 'SDE Intern · National Technical Research Organisation · 2025',
		blurb: 'Designed and built a security tool, onsite, that supports internal compliance and operations. Details are confidential under NDA.',
		links: [{ label: 'Experience', href: '/cv/' }],
	},
	{
		title: 'Group Policy Object Manager',
		meta: 'Smart India Hackathon 2024 finalist · C#, .NET, WPF',
		blurb: 'A Windows application that generates and manages Group Policy Objects aligned with CIS security benchmarks, built for the NTRO problem statement.',
		links: [{ label: 'GitHub', href: 'https://github.com/ramlakhanmadheshiya/Project-Techolics_' }],
	},
	{
		title: 'Bill Studio',
		meta: 'Web app · JavaScript, PWA, IndexedDB · 2026',
		blurb: 'Free, offline billing for 50+ countries: tax rules, a drag-and-drop bill designer, ledgers, reports and encrypted backups. All data stays on the device.',
		links: [{ label: 'Live', href: '/projects/bill-studio/' }, { label: 'GitHub', href: 'https://github.com/ramlakhanmadheshiya/bill-studio' }],
	},
];

const oss = [
	{ name: 'SciML / OrdinaryDiffEq.jl', note: 'Fixes to the delay differential equation solvers · 2 accepted, 5 under review', href: '/projects/#open-source' },
	{ name: 'ibis-project / ibis', note: 'Scrollable navigation menus in the documentation · accepted', href: 'https://github.com/ibis-project/ibis/pull/10090' },
];
const ext = (href: string) => /^https?:/.test(href);
---
<Base index={false}>
	<section class="hero">
		<p class="eyebrow">Software engineer · India</p>
		<h1>Ramlakhan Madheshiya</h1>
		<p class="lede">
			Software engineer. I contribute to the Julia SciML ecosystem, build games and offline-first web apps,
			and have a background in security tooling and full-stack development.
		</p>
		<div class="actions">
			<a class="btn primary" href="/projects/">See projects</a>
			<a class="btn" href="/cv/">Read my CV</a>
		</div>
		<div class="social">
			{SOCIAL.map((s) => <a href={s.href} rel="me noopener">{s.label}{s.label !== 'Email' && ' ↗'}</a>)}
		</div>
	</section>

	<section class="section">
			<div class="section-head"><h2>Highlights</h2><a href="/projects/">All projects →</a></div>
			<ol class="highlights">
				{highlights.map((h, i) => (
					<li>
						<span class="hl-num">{String(i + 1).padStart(2, '0')}</span>
						<div>
							<p class="meta">{h.meta}</p>
							<h3>{h.title}</h3>
							<p>{h.blurb}</p>
							<div class="links">{h.links.map((l) => <a href={l.href}>{l.label} {ext(l.href) ? '↗' : '→'}</a>)}</div>
						</div>
					</li>
				))}
			</ol>
	</section>

	<section class="section">
			<div class="section-head"><h2>Open source</h2><a href="/projects/#open-source">All contributions →</a></div>
			<ul class="post-list">
				{oss.map((o) => (
					<li>
						<h3><a href={o.href}>{o.name}</a></h3>
						<p>{o.note}</p>
					</li>
				))}
			</ul>
	</section>

	{posts.length > 0 && (
			<section class="section">
				<div class="section-head"><h2>Writing</h2><a href="/blog/">All posts →</a></div>
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<span class="meta">{fmtDate(post.data.pubDate)}</span>
							<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
							<p>{post.data.description}</p>
						</li>
					))}
				</ul>
			</section>
		)}

</Base>


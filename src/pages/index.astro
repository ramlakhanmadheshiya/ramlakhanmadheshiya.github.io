---
import Base from '../layouts/Base.astro';
import { getPosts, fmtDate } from '../utils';
import { openSource, games, webApps } from '../data/projects';

const posts = (await getPosts()).slice(0, 3);
const featured = [openSource[0], games[0], webApps[0]];
---
<Base>
	<section class="hero">
		<p class="eyebrow">Software engineer · India</p>
		<h1>Careful software, from numerical solvers to puzzle games.</h1>
		<p class="lede">
			I'm Ramlakhan. I contribute to the Julia SciML ecosystem, build small games and offline-first web apps,
			and have a background in security tooling and full-stack development.
		</p>
		<div class="actions">
			<a class="btn primary" href="/projects/">See projects</a>
			<a class="btn" href="/cv/">Read my CV</a>
		</div>
	</section>

	<section class="section">
		<h2>Right now</h2>
		<ul class="now">
			<li>Fixing delay differential equation bugs in <a href="https://github.com/SciML/OrdinaryDiffEq.jl">OrdinaryDiffEq.jl</a>: two pull requests merged, five in review.</li>
			<li>Shipping puzzle games with Godot. <a href="/BrainnovaStudio/games/">Single Shot</a> is in Google Play closed testing.</li>
			<li>Writing up what I learn along the way, from solver internals to level design, on the <a href="/blog/">blog</a>.</li>
		</ul>
	</section>

	<section class="section">
		<div class="section-head"><h2>Selected work</h2><a href="/projects/">All projects →</a></div>
		<ul class="rows">
			{featured.map((p) => (
				<li class="row">
					<div class="row-top">
						<h3>{p.name}</h3>
						{p.status && <span class="badge">{p.status}</span>}
					</div>
					<p>{p.blurb}</p>
					<div class="links">{p.links.map((l) => <a href={l.href}>{l.label} ↗</a>)}</div>
				</li>
			))}
		</ul>
	</section>

	{posts.length > 0 && (
		<section class="section">
			<div class="section-head"><h2>Writing</h2><a href="/blog/">All posts →</a></div>
			<ul class="post-list">
				{posts.map((post) => (
					<li>
						<span class="meta">{fmtDate(post.data.pubDate)}</span>
						<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
						<p>{post.data.description}</p>
					</li>
				))}
			</ul>
		</section>
	)}
</Base>

---
import Base from '../layouts/Base.astro';
import { getPosts, fmtDate } from '../utils';
import { SOCIAL } from '../consts';
import { pullRequests } from '../data/projects';

const posts = (await getPosts()).slice(0, 3);
const mergedPRs = pullRequests.filter((pr) => pr.state === 'merged');

const highlights = [
	{
		title: 'Security Compliance Suite',
		meta: 'SDE Intern · National Technical Research Organisation (NTRO) · 2025',
		blurb: 'Designed and built a security compliance tool, onsite, that supports internal hardening and audit operations. Architecture details confidential under NDA.',
		links: [{ label: 'CV Details', href: '/cv/' }],
	},
	{
		title: 'Group Policy Object Manager',
		meta: 'Smart India Hackathon 2024 finalist · C#, .NET, WPF',
		blurb: 'A Windows system administration application that generates and manages Group Policy Objects aligned with CIS security benchmarks, developed for the NTRO challenge.',
		links: [{ label: 'GitHub', href: 'https://github.com/ramlakhanmadheshiya/Project-Techolics_' }],
	},
	{
		title: 'Bill Studio',
		meta: 'Web app · JavaScript, PWA, IndexedDB · 2026',
		blurb: 'Free, offline-first billing for 50+ countries: tax rules (GST, VAT, sales tax), drag-and-drop bill designer, ledgers, reports, payment QR codes and client-side encrypted backups. Zero server requirement.',
		links: [
			{ label: 'Live App', href: '/projects/bill-studio/' },
			{ label: 'GitHub', href: 'https://github.com/ramlakhanmadheshiya/bill-studio' }
		],
	},
	{
		title: 'ghtrack',
		meta: 'Developer tooling · JavaScript, GitHub API, IndexedDB · 2026',
		blurb: 'Client-side GitHub lifetime activity analyzer: exact counts of pull requests, issues, reviews, and comments in ~2 seconds for accounts with 48,000+ items without tokens or sign-in.',
		links: [
			{ label: 'Live App', href: '/ghtrack/' },
			{ label: 'GitHub', href: 'https://github.com/ramlakhanmadheshiya/ghtrack' }
		],
	},
];

const ext = (href: string) => /^https?:/.test(href);
---
<Base index={false}>
	<!-- Fresh Minimal Hero -->
	<section class="hero">
		<span class="eyebrow">Software engineer · Gujarat, India</span>
		<h1>Ramlakhan Madheshiya</h1>
		<p class="lede">
			Software engineer building dependable tools and systems. Upstream contributor to Julia's SciML scientific computing libraries, developer of offline-first client-side web applications, and security tooling researcher.
		</p>
		<div class="actions">
			<a class="btn primary" href="/projects/">See projects</a>
			<a class="btn" href="/cv/">Read my CV</a>
		</div>
		<div class="social-links">
			{SOCIAL.map((s) => (
				<a href={s.href} target={ext(s.href) ? '_blank' : undefined} rel={ext(s.href) ? 'noopener noreferrer' : undefined}>
					{s.label}{s.label !== 'Email' && ' ↗'}
				</a>
			))}
		</div>
	</section>

	<!-- Highlights (Clean Numbered List) -->
	<section class="section">
		<div class="section-head">
			<h2>Highlights</h2>
			<a href="/projects/">All projects &rarr;</a>
		</div>
		<ol class="highlights-list">
			{highlights.map((h, i) => (
				<li class="highlights-item">
					<span class="hl-index">{String(i + 1).padStart(2, '0')}</span>
					<div class="highlights-content">
						<p class="meta">{h.meta}</p>
						<h3>{h.title}</h3>
						<p>{h.blurb}</p>
						<div class="item-links">
							{h.links.map((l) => (
								<a href={l.href} target={ext(l.href) ? '_blank' : undefined} rel={ext(l.href) ? 'noopener noreferrer' : undefined}>
									{l.label} {ext(l.href) ? '↗' : '→'}
								</a>
							))}
						</div>
					</div>
				</li>
			))}
		</ol>
	</section>

	<!-- Merged Open Source Contributions (Badge only in front of the PR, not the repo) -->
	<section class="section">
		<div class="section-head">
			<h2>Open source</h2>
			<a href="/projects/#open-source">All contributions &rarr;</a>
		</div>
		<ul class="post-rows">
			<li class="post-row">
				<h3>
					<a href="https://github.com/SciML/OrdinaryDiffEq.jl" target="_blank" rel="noopener noreferrer">SciML / OrdinaryDiffEq.jl</a>
				</h3>
				<p>Production Julia differential equation solvers: lag handling, zero-lag step bound preservation, and interpolation dispatch order.</p>
				<div class="pr-list-block" style="margin-top:0.75rem;display:grid;gap:0.4rem;">
					{mergedPRs.filter((p) => p.repo.includes('OrdinaryDiffEq')).map((pr) => (
						<div style="font-size:0.92rem;display:flex;align-items:baseline;gap:0.5rem;flex-wrap:wrap;">
							<span class="badge-merged">merged</span>
							<a href={pr.url} target="_blank" rel="noopener noreferrer">#{pr.number}: {pr.title}</a>
						</div>
					))}
				</div>
			</li>

			<li class="post-row">
				<h3>
					<a href="https://github.com/ibis-project/ibis" target="_blank" rel="noopener noreferrer">ibis-project / ibis</a>
				</h3>
				<p>Portable Python dataframe engine: resolved deep documentation accessibility with scrollable navigation menus.</p>
				<div class="pr-list-block" style="margin-top:0.75rem;display:grid;gap:0.4rem;">
					{mergedPRs.filter((p) => p.repo.includes('ibis')).map((pr) => (
						<div style="font-size:0.92rem;display:flex;align-items:baseline;gap:0.5rem;flex-wrap:wrap;">
							<span class="badge-merged">merged</span>
							<a href={pr.url} target="_blank" rel="noopener noreferrer">#{pr.number}: {pr.title}</a>
						</div>
					))}
				</div>
			</li>
		</ul>
	</section>

	<!-- Technical Writing -->
	{posts.length > 0 && (
		<section class="section">
			<div class="section-head">
				<h2>Writing</h2>
				<a href="/blog/">All posts &rarr;</a>
			</div>
			<ul class="post-rows">
				{posts.map((post) => (
					<li class="post-row">
						<span class="meta">{fmtDate(post.data.pubDate)}</span>
						<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
						<p>{post.data.description}</p>
					</li>
				))}
			</ul>
		</section>
	)}

	<!-- Outside Work -->
	<section class="section" style="margin-top:4.5rem;">
		<h2>Outside work</h2>
		<p style="margin-top:0.5rem;max-width:var(--measure);color:var(--muted);">
			In my spare time I make small puzzle games with Godot 4, exploring procedural mechanics and level validation algorithms.
			They live at <a href="/BrainnovaStudio/games/">Brainnova Studio</a>.
		</p>
	</section>
</Base>

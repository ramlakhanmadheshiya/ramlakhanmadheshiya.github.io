---
import Base from '../../layouts/Base.astro';
import { getPosts, fmtDate, readingTime } from '../../utils';

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.pubDate.getUTCFullYear()))].sort((a, b) => b - a);
---
<Base title="Blog" description="Notes on numerical solvers, game level design, and offline-first applications by Ramlakhan Madheshiya.">
	<header style="margin-bottom:3rem;">
		<span class="eyebrow">Writing</span>
		<h1>Blog & Notes</h1>
		<p class="lede">
			Notes on numerical differential equation solvers, procedural level design, and offline-first web apps.
			<a href="/rss.xml" style="margin-left:0.5rem;">RSS</a>
		</p>
	</header>

	{years.map((year) => (
		<section class="section" style="margin-top:2rem;">
			<span style="font-family:var(--font-mono);font-size:0.85rem;color:var(--muted);display:block;margin-bottom:0.75rem;">
				{year}
			</span>
			<ul class="post-rows">
				{posts.filter((p) => p.data.pubDate.getUTCFullYear() === year).map((post) => (
					<li class="post-row">
						<span class="meta">{fmtDate(post.data.pubDate)} · {readingTime(post.body ?? '')} min read</span>
						<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
						<p>{post.data.description}</p>
					</li>
				))}
			</ul>
		</section>
	))}
</Base>

---
import Base from '../../layouts/Base.astro';
import { getPosts, fmtDate, readingTime } from '../../utils';

const posts = await getPosts();
---
<Base title="Blog" description="Notes on numerical solvers, procedural game verification, and offline-first systems by Ramlakhan Madheshiya.">
	<div class="blog-wrap">
		<header class="blog-head">
			<span class="eyebrow">Writing</span>
			<h1>Blog & Notes</h1>
			<p class="lede">
				Articles on numerical differential equation solvers, procedural game verification, and offline-first software systems.
				<a href="/rss.xml" class="rss-link">RSS Feed &rarr;</a>
			</p>
		</header>

		<div class="blog-list">
			{posts.map((post) => (
				<article class="blog-item">
					<div class="blog-item-meta">
						<time datetime={post.data.pubDate.toISOString()}>
							{fmtDate(post.data.pubDate)}
						</time>
						<span class="meta-sep">·</span>
						<span>{readingTime(post.body ?? '')} min read</span>
						{post.data.tags.length > 0 && (
							<>
								<span class="meta-sep">·</span>
								<div class="blog-item-tags">
									{post.data.tags.map((t) => (
										<span class="tag-pill">#{t.toLowerCase()}</span>
									))}
								</div>
							</>
						)}
					</div>

					<h2 class="blog-item-title">
						<a href={`/blog/${post.id}/`}>{post.data.title}</a>
					</h2>

					<p class="blog-item-desc">{post.data.description}</p>

					<a href={`/blog/${post.id}/`} class="blog-item-link">
						Read article &rarr;
					</a>
				</article>
			))}
		</div>
	</div>
</Base>

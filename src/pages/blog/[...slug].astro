---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fmtDate, readingTime } from '../../utils';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description} type="article">
	<article>
		<header class="post-head">
			<p class="meta">
				{fmtDate(post.data.pubDate)} · {readingTime(post.body ?? '')} min read
				{post.data.tags.length > 0 && ` · ${post.data.tags.join(', ')}`}
			</p>
			<h1>{post.data.title}</h1>
			<p class="lede">{post.data.description}</p>
		</header>
		<div class="prose"><Content /></div>
	</article>
	<a class="back" href="/blog/">← All posts</a>
</Base>

---
import Base from '../layouts/Base.astro';
import { openSource, games, webApps, security, research, pullRequests, issues } from '../data/projects';
import type { Project } from '../data/projects';

const mergedPRs = pullRequests.filter((p) => p.state === 'merged');

const groups: { id: string; title: string; desc: string; items: Project[] }[] = [
	{
		id: 'web',
		title: 'Web apps & tools',
		desc: 'High-speed, offline-first applications and developer utilities built with zero server dependencies.',
		items: webApps,
	},
	{
		id: 'security',
		title: 'Security & systems',
		desc: 'Systems administration and compliance tooling built for security audits and hardening.',
		items: security,
	},
	{
		id: 'research',
		title: 'Research',
		desc: 'Manuscripts exploring vulnerability structures and kernel/userland defensive mechanisms.',
		items: research,
	},
	{
		id: 'games',
		title: 'Games',
		desc: 'Algorithmic puzzle and arcade games made with Godot 4 for Android and Web. Every room is verified by automated solvers.',
		items: games,
	},
];

const prs = (repo: string) => mergedPRs.filter((p) => p.repo === repo);
---
<Base title="Projects" description="Open-source contributions, web apps, security tooling and games by Ramlakhan Madheshiya.">
	<header style="margin-bottom:3rem;">
		<span class="eyebrow">Projects</span>
		<h1>Engineering Projects</h1>
		<p class="lede">Open-source contributions, offline-first web apps, developer tools, security tooling and research.</p>
		<nav style="display:flex;flex-wrap:wrap;gap:0.4rem 1.4rem;margin-top:1.5rem;font-size:0.92rem;">
			<a href="#open-source" style="color:var(--muted);text-decoration:none;">Open source (merged)</a>
			{groups.map((g) => (
				<a href={`#${g.id}`} style="color:var(--muted);text-decoration:none;">{g.title}</a>
			))}
		</nav>
	</header>

	<!-- Merged Open Source Section -->
	<section class="section" id="open-source" style="margin-top:0;">
		<h2>Open source</h2>
		<p style="color:var(--muted);margin:0.25rem 0 1.25rem;font-size:0.95rem;">
			Upstream contributions merged into projects maintained by others.
		</p>

		<ul class="post-rows">
			{openSource.map((p) => (
				<li class="post-row">
					<div style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;">
						<h3>{p.name}</h3>
						<span class="badge-merged">merged</span>
					</div>
					<p style="margin:0.35rem 0 0.6rem;color:var(--ink-secondary);">{p.blurb}</p>
					<div class="tags">
						{p.tags.map((t) => <span class="tag">{t}</span>)}
					</div>
					<div style="margin-top:0.75rem;">
						{prs(p.name.replace(' / ', '/')).map((pr) => (
							<div class="pr-row">
								<span class="num">#{pr.number}</span>
								<a href={pr.url} target="_blank" rel="noopener noreferrer">{pr.title}</a>
								<span class="badge-merged">merged</span>
							</div>
						))}
					</div>
				</li>
			))}
		</ul>

		<div style="margin-top:1.5rem;font-size:0.92rem;">
			<span style="font-family:var(--font-mono);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);display:block;margin-bottom:0.4rem;">
				Issues & Diagnoses
			</span>
			<p style="color:var(--muted);">
				{issues.map((l, i) => (
					<>
						<a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
						{i < issues.length - 1 ? ' · ' : ''}
					</>
				))}
			</p>
		</div>
	</section>

	<!-- Category Groups -->
	{groups.map((g) => (
		<section class="section" id={g.id} style="scroll-margin-top:5rem;">
			<h2>{g.title}</h2>
			{g.desc && <p style="color:var(--muted);margin:0.25rem 0 1.25rem;font-size:0.95rem;">{g.desc}</p>}

			<div class="projects-grid">
				{g.items.map((item) => (
					<div class="project-item">
						<div class="project-item-top">
							<h3>{item.name}</h3>
							<span class="meta">{item.status ? `${item.status} · ` : ''}{item.year}</span>
						</div>
						<p>{item.blurb}</p>
						<div class="tags">
							{item.tags.map((t) => <span class="tag">{t}</span>)}
						</div>
						{item.links.length > 0 && (
							<div class="item-links" style="margin-top:auto;padding-top:0.5rem;">
								{item.links.map((l) => (
									<a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
										{l.label} ↗
									</a>
								))}
							</div>
						)}
					</div>
				))}
			</div>
		</section>
	))}
</Base>
